# Copy to .env and fill in. Everything has a safe default except the entry id
# and the Azure OpenAI settings.

# ----------------------------------------------------------------- your team
# Find the entry id in the URL of your points page:
# fantasy.premierleague.com/entry/<THIS NUMBER>/event/1
FPL_ENTRY_ID=

# Path 1: programmatic login. Works from a home connection.
FPL_EMAIL=
FPL_PASSWORD=

# Path 2 (the normal way in): paste the cookie header from DevTools.
# fantasy.premierleague.com -> DevTools -> Network -> any /api/me/ request ->
# Request Headers -> copy the whole `cookie` value.
#
# It must contain `access_token` and `refresh_token` (FPL uses OAuth now; the
# older `pl_profile` + `sessionid` pair is still accepted if you have one). The
# access token lasts 8 hours and is refreshed automatically using the refresh
# token, which lasts about 180 days -- so this only needs re-pasting a couple of
# times a season. Check the state any time with `fpl-buddy token`.
#
# Premier League's bot protection returns 403 to datacenter IPs, so programmatic
# login is not an option anywhere but your own machine.
FPL_COOKIE_HEADER=

# --------------------------------------------------------------- azure openai
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21
# api_key locally; managed_identity on Container Apps (needs the azure extra).
AZURE_OPENAI_AUTH=api_key
AZURE_OPENAI_API_KEY=

# --------------------------------------------------------------------- safety
# Leave DRY_RUN=true until you have diffed the write payloads against a real
# browser capture. Nothing is POSTed to FPL while it is true.
DRY_RUN=true
# 0 means never take a points hit. Raise it deliberately, per gameweek.
MAX_POINTS_HIT=0
# false: an untouched proposal expires instead of being submitted.
AUTO_COMMIT_ENABLED=true
# false: approving marks it approved and the commit job submits it later, after
# re-validating against fresher data.
EXECUTE_ON_APPROVAL=true
# Skip auto-commit when the agent's own confidence is below this (0-1).
MIN_CAPTAIN_CONFIDENCE=0.0

# ----------------------------------------------------------------------- data
# How many gameweeks of fixtures the agent is shown. A transfer is judged over a
# run of fixtures, not just the one being submitted. Costs one extra request.
FIXTURE_HORIZON_GAMEWEEKS=5

# ------------------------------------------------------------------ knowledge
# Daily harvest of FPL articles (tips, team news) into STATE_DIR/knowledge as
# markdown. Leave KNOWLEDGE_SOURCES_FILE empty to disable the whole feature.
# Start from sources.example.yaml. See docs/deployment.md#harvesting-articles.
KNOWLEDGE_SOURCES_FILE=
# Local hour for the harvest. Keep it well before PROPOSE_HOURS_BEFORE_DEADLINE
# so a proposal reasons over articles collected that morning, not yesterday's.
KNOWLEDGE_HARVEST_HOUR=5
# The brief lists articles this recent, up to this many. Detail is loaded by
# tool, so raising the limit costs tokens on every run -- raise it deliberately.
# A video transcript is far longer than an article -- a half-hour video is
# ~28,000 characters against an article budget of 12,000.
TRANSCRIPT_INPUT_CHARS=40000
KNOWLEDGE_INDEX_DAYS=10
KNOWLEDGE_INDEX_LIMIT=15
# If a source config names a cookie_env (e.g. FFS_COOKIE for a Fantasy Football
# Scout membership), set that variable here. Without it, paywalled articles are
# stored as their free portion only.
# FFS_COOKIE=

# How article pages are fetched, in order; each is skipped when unavailable, so
# naming one you have not installed is harmless. httpx needs nothing and should
# stay last. Feeds, sitemaps and robots.txt always use httpx regardless.
KNOWLEDGE_FETCH_BACKENDS=firecrawl,scrapling,httpx
# Firecrawl renders JavaScript and gets past bot protection. Optional install:
# pip install -e '.[firecrawl]'. Free tier is 1000 credits/month, one per page --
# a daily 26-article harvest is ~780, so the reserve below matters.
FIRECRAWL_API_KEY=
FIRECRAWL_CREDIT_RESERVE=50
# Scrapling is a local fallback that impersonates a browser's TLS fingerprint,
# which is enough for most 403s. Optional install: pip install -e '.[scrapling]'.
# Its plain fetcher needs no browser binaries; the stealth one below does, and
# requires running `scrapling install` first.
SCRAPLING_STEALTH=false

# ------------------------------------------------------------------- timings
PROPOSE_HOURS_BEFORE_DEADLINE=36
COMMIT_MINUTES_BEFORE_DEADLINE=45
TIMEZONE=Asia/Kolkata

# The scheduler lives inside this process, which is why the container has to
# stay up. Set false and it serves the API only -- no scheduler, and no Discord
# gateway either, since both are things that keep a container alive. Something
# external then has to run `fpl-buddy tick`, or no proposal is ever made or
# committed. See docs/serverless.md; infra/*/deploy.sh set this for you.
SCHEDULER_ENABLED=true

# How often `fpl-buddy tick` re-reads the live deadline while it is still far
# away. Inside the propose window it re-reads every tick regardless, because
# that is when a moved deadline matters. Only used by the tick driver.
TICK_ANCHOR_INTERVAL_HOURS=6

# --------------------------------------------------------------------- state
# file: JSON under STATE_DIR (mount a volume in the cloud, or lose proposals on
# restart). azure_table: Azure Table Storage.
#
# STATE_DIR must be durable for a second reason, and this one applies whichever
# backend you pick: refreshed FPL tokens are cached there, and the refresh token
# rotates on every use. Lose the directory and the copy in this file is already
# spent, so you get one refresh per paste and then the deadline job starts
# failing. Since a durable filesystem is required either way, `file` on a
# mounted volume is the simplest thing that works.
STATE_BACKEND=file
STATE_DIR=./.state
AZURE_TABLE_CONNECTION_STRING=
AZURE_TABLE_NAME=fplproposals

# ------------------------------------------------------------- notifications
# none | log | smtp | webhook | discord
NOTIFY_CHANNEL=log
# Must be the externally reachable URL, or approval links won't open.
PUBLIC_BASE_URL=http://localhost:8080
# Signs approval links. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Rotating it invalidates every outstanding link.
APPROVAL_SECRET=change-me
APPROVAL_LINK_TTL_HOURS=72
# Set once the service is on a public URL: read endpoints then require X-API-Key.
API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
WEBHOOK_URL=

# NOTIFY_CHANNEL=discord: a bot posts each proposal as an embed with
# Approve/Amend/Reject buttons, and reads messages in the same channel as
# notes folded into the next proposal. See docs/deployment.md#discord for how
# to create the bot, invite it, and enable the MESSAGE CONTENT privileged
# intent the notes feature needs.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------- misc
LOG_LEVEL=INFO
PORT=8080
